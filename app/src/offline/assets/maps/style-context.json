{
  "version": 8,
  "name": "PhotoMap Offline Streets",
  "glyphs": "local://fonts/{fontstack}/{range}.pbf",
  "sources": {
    "context": {
      "type": "vector",
      "url": "pmtiles://local://context.pmtiles",
      "minzoom": 0,
      "maxzoom": 6,
      "bounds": [
        -180,
        -85,
        180,
        85
      ]
    }
  },
  "layers": [
    {
      "id": "context-background",
      "type": "background",
      "paint": {
        "background-color": "#cbdde3"
      }
    },
    {
      "id": "context-land",
      "type": "fill",
      "source": "context",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#efeee7"
      }
    },
    {
      "id": "context-water",
      "type": "fill",
      "source": "context",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a9d4e9"
      },
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ]
    },
    {
      "id": "context-waterways",
      "type": "line",
      "source": "context",
      "source-layer": "water",
      "paint": {
        "line-color": "#83bfdc",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.4,
          13,
          1,
          17,
          2.5
        ]
      },
      "minzoom": 8,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ]
    },
    {
      "id": "context-major-roads",
      "type": "line",
      "source": "context",
      "source-layer": "roads",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind_detail"
          ],
          [
            "motorway",
            "motorway_link",
            "trunk",
            "trunk_link"
          ],
          "#dba866",
          [
            "primary",
            "primary_link"
          ],
          "#e9c78e",
          "#f0dfbc"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.6,
          12,
          1.8,
          17,
          5
        ]
      },
      "minzoom": 6,
      "filter": [
        "in",
        "kind",
        "highway",
        "major_road"
      ]
    },
    {
      "id": "context-country-labels",
      "type": "symbol",
      "source": "context",
      "source-layer": "places",
      "paint": {
        "text-color": "#566156",
        "text-halo-color": "#f4f2ec",
        "text-halo-width": 1.3
      },
      "minzoom": 1,
      "maxzoom": 7,
      "filter": [
        "all",
        [
          "==",
          "kind",
          "country"
        ],
        [
          "!",
          [
            "in",
            [
              "get",
              "name"
            ],
            [
              "literal",
              [
                "中国",
                "China",
                "中华人民共和国"
              ]
            ]
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 16,
        "text-padding": 12,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ]
      }
    }
  ]
}