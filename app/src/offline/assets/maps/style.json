      "minzoom": 11,
      "filter": [
        "all",
        [
          "any",
          [
            "has",
            "name"
          ],
          [
            "has",
            "name:zh-Hans"
          ],
          [
            "has",
            "name:en"
          ]
        ],
        [
          "!=",
          [
            "get",
            "kind"
          ],
          "administrative"
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          10,
          16,
          12
        ],
        "text-padding": 8,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ],
        "text-max-width": 7,
        "text-anchor": "bottom",
        "text-offset": [
          0,
          -0.4
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "roads",
      "paint": {
        "text-color": "#65706a",
        "text-halo-color": "#f4f2ec",
        "text-halo-width": 1.5
      },
      "minzoom": 11,
      "filter": [
        "all",
        [
          "any",
          [
            "has",
            "name"
          ],
          [
            "has",
            "name:zh-Hans"
          ],
          [
            "has",
            "name:en"
          ]
        ],
        [
          "!",
          [
            "in",
            [
              "get",
              "kind"
            ],
            [
              "literal",
              [
                "rail",
                "aeroway",
                "ferry"
              ]
            ]
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          10,
          16,
          12
        ],
        "text-padding": 4,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ],
        "symbol-placement": "line",
        "symbol-spacing": 220,
        "text-max-angle": 35,
        "text-rotation-alignment": "map",
        "text-keep-upright": true
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "water",
      "paint": {
        "text-color": "#5e8493",
        "text-halo-color": "#f4f2ec",
        "text-halo-width": 1.3
      },
      "minzoom": 10,
      "filter": [
        "any",
        [
          "has",
          "name"
        ],
        [
          "has",
          "name:zh-Hans"
        ],
        [
          "has",
          "name:en"
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-padding": 8,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ]
