        [
          "!in",
          "kind_detail",
          "city",
          "town",
          "county",
          "district",
          "borough"
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          10,
          16,
          12
        ],
        "text-padding": 7,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ]
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "pois",
