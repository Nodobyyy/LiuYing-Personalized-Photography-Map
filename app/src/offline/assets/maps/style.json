{
  "version": 8,
  "name": "PhotoMap Offline Streets",
  "glyphs": "local://fonts/{fontstack}/{range}.pbf",
  "sources": {
    "base": {
      "type": "vector",
      "url": "pmtiles://local://china.pmtiles",
      "minzoom": 0,
      "maxzoom": 10,
      "bounds": [
        73,
        3,
        136,
        54
      ]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#cbdde3"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "base",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#efeee7"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "base",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dce4d5",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "base",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e4e7db",
        "fill-opacity": 0.6
      },
      "minzoom": 7
    },
    {
      "id": "water",
      "type": "fill",
      "source": "base",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a9d4e9"
      },
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ]
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "base",
      "source-layer": "water",
      "paint": {
        "line-color": "#83bfdc",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.4,
          13,
          1,
          17,
          2.5
        ]
      },
      "minzoom": 8,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ]
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "base",
      "source-layer": "buildings",
      "paint": {
        "fill-color": "#d2d4cb",
        "fill-outline-color": "#c1c8bc"
      },
      "minzoom": 13
    },
    {
      "id": "roads",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          10,
          1.3,
          15,
          3.2,
          17,
          5
        ]
      },
      "minzoom": 5,
      "filter": [
        "!=",
        "kind",
        "rail"
      ]
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind_detail"
          ],
          [
            "motorway",
            "motorway_link",
            "trunk",
            "trunk_link"
          ],
          "#dba866",
          [
            "primary",
            "primary_link"
          ],
          "#e9c78e",
          "#f0dfbc"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.6,
          12,
          1.8,
          17,
          5
        ]
      },
      "minzoom": 6,
      "filter": [
        "in",
        "kind",
        "highway",
        "major_road"
      ]
    },
    {
      "id": "railways",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "paint": {
        "line-color": "#a7b1aa",
        "line-width": 1,
        "line-dasharray": [
          2,
          2
        ]
      },
      "minzoom": 11,
      "filter": [
        "==",
        "kind",
        "rail"
      ]
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "base",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#a6aca0",
        "line-width": 0.8,
        "line-dasharray": [
          3,
          2
        ]
      },
      "minzoom": 7,
      "filter": [
        "in",
        "kind",
        "county",
        "locality"
      ]
    },
