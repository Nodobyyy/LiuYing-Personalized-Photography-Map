      "id": "country-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "places",
      "paint": {
        "text-color": "#566156",
        "text-halo-color": "#f4f2ec",
        "text-halo-width": 1.3
      },
      "minzoom": 1,
      "maxzoom": 3.25,
      "filter": [
        "==",
        "kind",
        "country"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 16,
        "text-padding": 12,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ]
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "places",
      "paint": {
        "text-color": "#566156",
        "text-halo-color": "#f4f2ec",
        "text-halo-width": 1.3
      },
      "minzoom": 3.25,
      "filter": [
        "all",
        [
          "==",
          "kind",
          "locality"
        ],
        [
          "in",
          "kind_detail",
          "city",
          "town"
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3.25,
          11,
          10,
          14
        ],
        "text-padding": 7,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ]
      }
    },
    {
      "id": "county-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "places",
      "paint": {
        "text-color": "#566156",
        "text-halo-color": "#f4f2ec",
        "text-halo-width": 1.3
      },
      "minzoom": 6,
      "filter": [
        "any",
        [
          "==",
          "kind",
          "county"
        ],
        [
          "in",
          "kind_detail",
          "county",
          "district",
          "borough"
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-padding": 6,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "min_zoom"
          ],
          0
        ]
