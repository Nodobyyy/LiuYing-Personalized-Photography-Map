          12
        ],
        "text-padding": 4,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "rank"
          ],
          0
        ],
        "symbol-placement": "line",
        "symbol-spacing": 220,
        "text-max-angle": 35,
        "text-rotation-alignment": "map",
        "text-keep-upright": true
      }
