      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:zh-Hans"
          ],
          [
            "get",
            "name:zh"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
